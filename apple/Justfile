# Marketing version from [workspace.package] in the root Cargo.toml.
version := `cargo pkgid --manifest-path ../Cargo.toml -p shared | sed 's/.*#//'`

# generates Swift types via codegen binary
typegen:
    cargo run --package shared --bin codegen \
        --features codegen,facet_typegen \
        -- --language swift --output-dir generated

# builds the shared library as a Swift package using BoltFFI
package:
    cd ../shared && boltffi pack apple

# rebuilds the Xcode project from project.yml
generate-project:
    CARGO_PKG_VERSION={{version}} xcodegen

# generates types, builds shared package, and regenerates Xcode project
generate: typegen package generate-project

# builds the project (generates first)
build: generate
    xcodebuild \
        -project ImploreApp.xcodeproj \
        -scheme ImploreApp-iOS \
        -configuration Debug \
        -destination 'generic/platform=iOS Simulator' \
        build

# local development workflow
dev: build

# publish unified observances catalog to S3
publish-observances:
    #!/usr/bin/env bash
    set -euo pipefail
    bucket="s3://atgeo-intercede-app-090552655796-us-east-2-an/observances"
    for locale in en fr es; do
        aws s3 cp "../content/observances/${locale}.json" \
            "${bucket}/${locale}.json" \
            --content-type application/json
    done
